{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sparkbot Roundtable",
  "version": "0.2.1",
  "identifier": "com.sparkpitlabs.sparkbot.public",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sparkbot Roundtable",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:18765"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sparkbot-server",
      "binaries/sparkbot-roundtable"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "publisher": "SparkPit Labs"
  }
}
